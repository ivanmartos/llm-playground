{
  "openapi": "3.0.3",
  "info": {
    "title": "Hello API",
    "version": "2.0.0",
    "description": "A small versioned hello-world API."
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "paths": {
    "/v1/hello": {
      "get": {
        "operationId": "helloV1",
        "summary": "Greet someone",
        "description": "Returns a greeting for the given name. Defaults to 'World' if no name is given.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Name of the person to greet (max 100 characters).",
            "schema": { "type": "string", "maxLength": 100, "default": "World" }
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Hello, Alice!" }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/v2/hello": {
      "get": {
        "operationId": "helloV2",
        "summary": "Greet someone (v2)",
        "description": "Returns a v2 greeting for the given name, including the API version. Defaults to 'stranger' if no name is given.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Name of the person to greet (max 100 characters).",
            "schema": { "type": "string", "maxLength": 100, "default": "stranger" }
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "greeting": { "type": "string", "example": "Hi Alice, greetings from API v2!" },
                    "apiVersion": { "type": "string", "example": "v2" }
                  },
                  "required": ["greeting", "apiVersion"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  }
}
